apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: spyre-card-management
  namespace: "FILLED BY THE OPERATOR"
  labels:
    app: cardmgmt
spec:
  selector:
    matchLabels:
      app: cardmgmt
  template:
    metadata:
      labels:
        app: cardmgmt
    spec:
      nodeSelector:
        ibm.com/spyre.present: "true"
      # schedulerName is deliberately unset here. TransformCardManagement sets
      # it to spyre-scheduler only for the device-plugin path; DRA-based
      # allocation uses the default scheduler.
      serviceAccountName: spyre-card-management
      priorityClassName: system-node-critical
      securityContext:
        runAsUser: 0
      volumes:
      - name: configs
        configMap:
          name: spyre-cardmgmt-config
          optional: true
      # /etc/ibm/spyre is the read-only ConfigMap above, but card management creates /etc/ibm/spyre/diags (CM_DIAG_DIR)
      # at start: image v1.2.5 logs "Read-only file system" and falls back to /tmp, v1.3.1-rc.1 exits.
      # So only diags is a writable emptyDir, mounted inside the ConfigMap mount; the ini keeps being refreshed by kubelet.
      - name: cardmgmt-diags
        emptyDir: {}
      - name: imagepullsecret
        secret:
          secretName: registry-dockerconfig-secret
      - name: health-check-api-socket
        hostPath:
          path: /usr/local/etc/spyre-cardmgmt
          type: DirectoryOrCreate
      - name: spyre-cert
        secret:
          secretName: spyre-cert
          optional: true
      initContainers:
      - name: open-socket-dir
        image: "FILLED BY THE OPERATOR"
        command: ["/bin/sh", "-c", "chmod 0777 /var/run/cardmgmt-health-check-api"]
        securityContext:
          runAsUser: 0
          seLinuxOptions:
            type: spc_t
        volumeMounts:
        - name: health-check-api-socket
          mountPath: /var/run/cardmgmt-health-check-api
      containers:
      - name: app
        image: "FILLED BY THE OPERATOR"
        imagePullPolicy: Always
        # Why a shell: spec.cardManagement.args in SpyreClusterPolicy can override the start command,
        # so the operator can run card management images whose start script differs.
        # Security risk: this container is privileged,
        # so anyone who can edit SpyreClusterPolicy can run arbitrary code on the node.
        # Mitigation: restrict write access to SpyreClusterPolicy to admins (or permitted users).
        command: ["/bin/sh", "-c"]
        args: ["/opt/ibm/spyre/aiucardmgmt/bin/aiucardmgmt/platform/openshift/run_cardmgmt.sh"]
        securityContext:
          privileged: true
        env:
        - name: PYTHONUNBUFFERED
          value: "1"
        - name: AIUPLATFORM
          value: openshift
        - name: CARDMGMT_SVC_SERVICE_PORT_PFLISTENER
          value: "65500"
        - name: CARDMGMT_SVC_SERVICE_PORT_VFLISTENER
          value: "65501"
        - name: NODE_NAME
          valueFrom:
            fieldRef:
              fieldPath: spec.nodeName
        # Card management uses this one value both as the address it listens on and as the address it hands to
        # the PF/VF/diagnostics runners to connect to. Kubernetes would inject the ClusterIP of cardmgmt-svc,
        # which a pod cannot bind ("Cannot assign requested address"). The pod IP can be bound and is reachable
        # by the runners (they run with host networking on the same node). Explicit env wins over the injected one.
        - name: CARDMGMT_SVC_SERVICE_HOST
          valueFrom:
            fieldRef:
              fieldPath: status.podIP
        resources:
          limits:
            cpu: 1000m
            memory: 512Mi
          requests:
            cpu: 30m
            memory: 64Mi
        ports:
        - containerPort: 65500
        - containerPort: 65501
        volumeMounts:
        - name: configs
          mountPath: /etc/ibm/spyre
        - name: cardmgmt-diags
          mountPath: /etc/ibm/spyre/diags
        - name: imagepullsecret
          mountPath: /var/imagepullsecret
          readOnly: true
      - name: health-api
        image: "FILLED BY THE OPERATOR"
        imagePullPolicy: Always
        env:
        - name: API_GRPC_SOCKET_PATH
          value: "/var/run/cardmgmt-health-check-api/health-check-api.sock"
        - name: WORKER_RPYC_PORT
          value: "50001"
        - name: RPYC_TIMEOUT
          value: "30"
        - name: RPYC_RETRY_COUNT
          value: "3"
        - name: RPYC_RETRY_DELAY
          value: "1"
        - name: LOG_LEVEL
          value: "INFO"
        resources:
          limits:
            cpu: 250m
            memory: 256Mi
          requests:
            cpu: 100m
            memory: 128Mi
        securityContext:
          runAsNonRoot: true
          runAsUser: 1000
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: false
          capabilities:
            drop:
            - ALL
          seccompProfile:
            type: RuntimeDefault
          seLinuxOptions:
            type: spc_t
        volumeMounts:
        - name: health-check-api-socket
          mountPath: /var/run/cardmgmt-health-check-api
        - name: spyre-cert
          mountPath: /etc/cardmgmt-health-check-api/certs
          readOnly: true
        livenessProbe:
          exec:
            command:
            - python
            - -c
            - "import os, socket; s=socket.socket(socket.AF_UNIX); s.connect(os.environ['API_GRPC_SOCKET_PATH']); s.close()"
          initialDelaySeconds: 10
          periodSeconds: 30
          timeoutSeconds: 5
          failureThreshold: 3
        readinessProbe:
          exec:
            command:
            - python
            - -c
            - "import os, socket; s=socket.socket(socket.AF_UNIX); s.connect(os.environ['API_GRPC_SOCKET_PATH']); s.close()"
          initialDelaySeconds: 5
          periodSeconds: 10
          timeoutSeconds: 5
          failureThreshold: 3
